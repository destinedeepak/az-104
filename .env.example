# Environment Configuration
NODE_ENV=development

# Azure Key Vault Configuration (Production only)
# In production, set NODE_ENV=production and provide:
# KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/
KEY_VAULT_URL=

# Database Configuration
# For Local Development (NODE_ENV=development): Set all values here
# For Production (NODE_ENV=production in Azure App Service):
#   - Set NODE_ENV=production
#   - Set KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/
#   - Add DB_SERVER, DB_PORT, DB_NAME, DB_USER in: Azure Portal → App Service → Configuration → Application settings
#   - Add db-password1 secret in Azure Key Vault (app will use Managed Identity)
#   - DO NOT set DB_PASSWORD in App Service settings (it will be fetched from Key Vault)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ProductsDB
DB_USER=sa
DB_PASSWORD=YourPassword123
